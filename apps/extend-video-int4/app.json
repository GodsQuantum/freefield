{
  "$schema": "../../schema/app.schema.json",
  "id": "extend-video-int4",
  "name": "Extend Video INT4 compact",
  "section": "video",
  "summary": "Optional MiniMax H3 INT4 video extension with audio. Native 78-frame H.264/AAC sample verified; original INT8 remains available.",
  "higgsfield_feature": "Extend Video (low-memory INT4 preview)",
  "pack": "video-h3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_i2v.json",
    "comfyui": "0.42.0",
    "notes": "Cloud9 00c native E2E 2026-11-22 PASS with Merserk INT4: existing 39-frame input + 39 new frames, 3.25s H264/AAC, 0 OOM, 8 steps 0.1MP; video continuity PSNR 45.16dB and audio correlation 0.9966. Freefield CLI E2E still to validate. Original INT8 retained. Longer/high-res not tested."
  },
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Your clip",
      "required": true,
      "limits": {
        "max_mb": 60
      },
      "help": "Up to about 15 s; 24 or 25 fps clips join best.",
      "bind": [
        {
          "node": "ff_clip",
          "field": "file"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What happens next",
      "required": true,
      "default": "The scene continues naturally: same people, place, light and camera style.",
      "bind": [
        {
          "node": "105:104",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds to add",
      "min": 1,
      "max": 1,
      "step": 1,
      "default": 1,
      "bind": [
        {
          "node": "105:111",
          "field": "value"
        }
      ],
      "help": "Only +1s generation qualified on Cloud9 (39 frames, +1.625s actual)."
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 8,
      "step": 1,
      "default": 8,
      "help": "Fixed 8 steps for validated low-memory INT4 profile.",
      "bind": [
        {
          "node": "105:124",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "105:15",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Extended clip"
    }
  ],
  "models": [
    {
      "repo": "Merserk/MiniMax-H3-INT4-ConvRot",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int4_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 11.34,
      "phase": "denoise",
      "license": "MiniMax H3 Community License",
      "pack_optional": true
    },
    {
      "repo": "Merserk/MiniMax-H3-INT4-ConvRot",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int4_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 14.95,
      "phase": "encode",
      "license": "MiniMax H3 Community License",
      "pack_optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "MiniMax H3 (MiniMax H3 Community License)",
    "Merserk INT4 ConvRot quantization"
  ],
  "test": {
    "clip": "test/clip.mp4",
    "duration": 1,
    "steps": 8
  },
  "modes": [
    "extend-video",
    "extend-video-int4"
  ],
  "mode_label": "Extend video variant"
}
