{
  "$schema": "../../schema/app.schema.json",
  "id": "flux3-klein-local",
  "name": "FLUX 3 Klein Q5 · Heretic Q4",
  "section": "image",
  "pack": "image-flux3-gguf",
  "status": "ready",
  "summary": "FLUX 3 Klein Q5 diffusion with Heretic/DHQ Qwen3-VL Q4 text encoder and matched vision tower; local ROCm.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_flux3_klein_distilled_t2i.json",
    "comfyui": "0.45.0",
    "notes": "Cloud9 gfx1103 ROCm E2E validated at 256x256 in 112 seconds using official GGUF-Qwen3VL-TE addon that supplies Flux3 text conditioning. FLUX Kommunity License governs diffusion weights; abliterated encoder does not guarantee unrestricted images."
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "Natural light portrait of a person in a city street, photorealistic",
      "bind": [
        {
          "node": "18:4",
          "field": "text"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 16,
      "bind": [
        {
          "node": "18:7",
          "field": "steps"
        }
      ]
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 512,
      "options": [
        {
          "value": 256,
          "label": "256"
        },
        {
          "value": 384,
          "label": "384"
        },
        {
          "value": 512,
          "label": "512"
        },
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        },
        {
          "value": 2048,
          "label": "2048"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "width"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 512,
      "options": [
        {
          "value": 256,
          "label": "256"
        },
        {
          "value": 384,
          "label": "384"
        },
        {
          "value": 512,
          "label": "512"
        },
        {
          "value": 768,
          "label": "768"
        },
        {
          "value": 1024,
          "label": "1024"
        },
        {
          "value": 1280,
          "label": "1280"
        },
        {
          "value": 1536,
          "label": "1536"
        },
        {
          "value": 2048,
          "label": "2048"
        }
      ],
      "bind": [
        {
          "node": "18:6",
          "field": "height"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "18:7",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "9",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "unsloth/flux-3-image-klein-GGUF",
      "file": "flux-3-image-klein-UD-Q5_K_XL.gguf",
      "dir": "unet_gguf",
      "gb": 4.48,
      "phase": "denoise",
      "license": "FLUX Kommunity License v1.0"
    },
    {
      "repo": "pottokao/FLUX.3-Klein-Text-Encoder-Heretic-DHQ-GGUF",
