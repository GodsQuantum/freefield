  "test": {
    "prompt": "A single red apple beside two blue ceramic cups on a pale wooden table, professional studio photograph",
    "width": 256,
    "height": 256,
    "steps": 16,
    "seed": 422026,
    "note": "ComfyUI direct 256x256 PNG real output PASS, 112.2sec, GPU 780M, no backend retries; app route still to test"
