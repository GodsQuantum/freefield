{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-video-int4",
  "name": "H3 Video INT4 compact",
  "section": "video",
  "summary": "Low-memory H3 with synchronized sound using Merserk INT4. One 1.625-second 416x256 H.264/AAC video verified on Cloud9; original H3 INT8 remains available.",
  "higgsfield_feature": "Create Video (low-memory preview)",
  "pack": "video-h3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_t2v.json",
    "comfyui": "0.45.0",
    "notes": "Cloud9 native E2E Merserk INT4 TE+DiT passed 2026-11-22: 1s request outputs 1.625s 416x256 24fps with AAC; FFprobe and full decode pass; 0 OOM, min host RAM available15.547GiB, max GTT8.638GiB, max CT410 swap6.993GiB, total 924.35s from slow USB HDD. CPU MiniMax VAE fix is required on cloud9 ComfyUI. 2s not benchmarked. Int8 remains separate default app."
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "Cinematic studio video of a small red toy robot slowly waving one hand on a light wooden table, clear electronic sound",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "140:131",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Format",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        }
      ],
      "bind": [
        {
          "node": "115",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1,
      "bind": [
        {
          "node": "140:133",
          "field": "value"
        }
      ],
      "help": "1s request produced 1.625s actual output in the verified test. 2s option not yet E2E tested."
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 8,
      "step": 1,
      "default": 8,
      "help": "Fixed eight steps to match the tested INT4 memory-safe configuration.",
      "bind": [
        {
          "node": "140:137",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "140:129",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Merserk/MiniMax-H3-INT4-ConvRot",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int4_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 11.34,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Merserk/MiniMax-H3-INT4-ConvRot",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int4_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 14.95,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "MiniMax H3 (MiniMax H3 Community License)",
    "Merserk INT4 ConvRot quantization"
  ],
  "test": {
    "prompt": "Cinematic studio video of a small red toy robot slowly waving one hand on a light wooden table",
    "duration": 1,
    "steps": 8
  },
  "modes": [
    "h3-video",
    "h3-video-int4"
  ],
  "mode_label": "H3 variant"
}
