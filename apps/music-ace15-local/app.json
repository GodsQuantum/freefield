    {
      "id": "style",
      "type": "textarea",
      "label": "Style et instruments",
      "required": true,
      "default": "Instrumental jazz-funk français chaleureux, basse ronde, Rhodes électrique, batterie acoustique souple, production studio",
      "bind": [
        {
          "node": "4",
          "field": "tags"
        }
      ],
      "help": "Genre, humeur, instrumentation, tempo et arrangement. Aligner BPM, tonalité et mesure avec cette description."
    },
