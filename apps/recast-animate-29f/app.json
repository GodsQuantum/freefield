      "license": "Apache-2.0"
    },
    {
      "repo": "city96/umt5-xxl-encoder-gguf",
      "file": "umt5-xxl-encoder-Q4_K_M.gguf",
      "dir": "clip_gguf",
      "gb": 3.655145312,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
      "file": "split_files/clip_vision/clip_vision_h.safetensors",
      "dir": "clip_vision",
      "gb": 1.26,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Kijai/WanVideo_comfy",
      "file": "Wan2_1_VAE_bf16.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/sam3.1",
      "file": "checkpoints/sam3.1_multiplex_fp16.safetensors",
      "dir": "checkpoints",
      "gb": 1.75,
      "phase": "aux",
      "license": "SAM License"
    }
  ],
  "notes": "Un seul sujet clairement décrit. 29 images de sortie, environ 17 min 25 s sur le test Cloud9. Ressemblance faciale approximative, cadrage susceptible de se resserrer. Vérifié sur un clip de 1,81 s ; ni HD ni longue durée certifiées. Utiliser des sources autorisées.",
