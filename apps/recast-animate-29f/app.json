{
  "$schema": "../../schema/app.schema.json",
  "id": "recast-animate-29f",
  "name": "Recast — animation étendue (29 images)",
  "section": "video",
  "pack": "video-scail",
  "status": "ready",
  "higgsfield_feature": "Motion transfer",
  "summary": "Animation native en deux fenêtres de 17 images avec 5 images de raccord. 320 × 320, 29 images : 1,81 s à 16 i/s.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_wan21_scail2_character_replacement_int8.json",
    "comfyui": "0.42.0",
    "notes": "Native two-window SCAIL-2 continuation with 5-frame anchor; exact 45-node actual CLI graph, same weights; bounded SAM batches, immutable GGUF residency and sequential tiled decode. Proof 10p."
  },
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Video",
      "required": true,
      "limits": {
        "max_mb": 200
      },
      "help": "29 images requises après le début choisi ; un seul sujet bien visible, clip à cadence constante.",
      "bind": [
        {
          "node": "155",
          "field": "file"
        }
      ]
    },
    {
      "id": "character",
      "type": "image",
      "label": "Your character",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "help": "One person, full body if the video shows the full body",
      "bind": [
        {
          "node": "30",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Describe the result",
      "required": true,
      "default": "A person in a red jacket walks through a sunny park, natural light, realistic",
      "bind": [
        {
          "node": "213:154",
          "field": "text"
        }
      ]
    },
    {
      "id": "target",
      "type": "text",
      "label": "Sujet à suivre dans le clip",
      "default": "person",
      "help": "Text description of one subject. The highest-scoring match is detected in each frame; not for multiple similar subjects.",
      "bind": [
        {
          "node": "213:191",
          "field": "text"
        }
      ]
    },
    {
      "id": "mode",
      "type": "select",
      "label": "Mode",
      "default": false,
      "options": [
        {
          "value": false,
          "label": "Animation de la référence"
        }
      ],
      "bind": [
        {
          "node": "213:203",
          "field": "value"
        }
      ],
      "help": "Animation : reproduit le mouvement du clip dans le décor de la référence."
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 320,
      "options": [
        {
          "value": 320,
          "label": "320 px (aperçu validé)"
        }
      ],
      "bind": [
        {
          "node": "213:178",
          "field": "value"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 320,
      "options": [
        {
          "value": 320,
          "label": "320 px (aperçu validé)"
        }
      ],
      "bind": [
        {
          "node": "213:179",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "213:19",
          "field": "noise_seed"
        },
        {
          "node": "ff_sample2",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "start_seconds",
      "type": "number",
      "label": "Début du clip (s)",
      "min": 0,
      "max": 3600,
      "step": 0.01,
      "default": 0,
      "bind": [
        {
          "node": "ff_window",
          "field": "start_seconds"
        }
      ],
      "help": "Début de la fenêtre de 29 images (deux segments de 17, raccord de 5 images). Durée de sortie : 29 / cadence source."
    },
    {
      "id": "reference_target",
      "type": "text",
      "label": "Sujet de la référence",
      "default": "person",
      "bind": [
        {
          "node": "213:212",
          "field": "text"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "202",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "realrebelai/SCAIL-2_GGUF",
      "file": "SCAIL-2-Q3_K_M.gguf",
      "dir": "unet_gguf",
      "gb": 8.108662432,
      "phase": "denoise",
      "license": "MIT"
    },
    {
      "repo": "Comfy-Org/SCAIL-2",
      "file": "loras/wan2.1_SCAIL_2_DPO_lora_bf16.safetensors",
