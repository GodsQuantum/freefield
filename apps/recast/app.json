{
  "$schema": "../../schema/app.schema.json",
  "id": "recast",
  "name": "Recast — aperçu remplacement vidéo",
  "section": "video",
  "pack": "video-scail",
  "status": "ready",
  "higgsfield_feature": "Character swap",
  "summary": "Remplacement vidéo SCAIL-2 Q3, certifié sur 17 images, 384 × 384. Aperçu : identité et cadrage approximatifs.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_wan21_scail2_character_replacement_int8.json",
    "comfyui": "0.42.0",
    "notes": "Actual Freefield CLI 09n: native framewise SAM3, scoped sequential UMT5 Q4/SCAIL-2 Q3, both original LoRAs additive, six steps. Positive limited replacement review; animation-only branch not qualified."
  },
  "inputs": [
    {
      "id": "clip",
      "type": "video",
      "label": "Video",
      "required": true,
      "limits": {
        "max_mb": 200
      },
      "help": "Uses the first 17 frames in this memory-bounded preview.",
      "bind": [
        {
          "node": "155",
          "field": "file"
        }
      ]
    },
    {
      "id": "character",
      "type": "image",
      "label": "Your character",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "help": "One person, full body if the video shows the full body",
      "bind": [
        {
          "node": "30",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Describe the result",
      "required": true,
      "default": "A person in a red jacket walks through a sunny park, natural light, realistic",
      "bind": [
        {
          "node": "213:154",
          "field": "text"
        }
      ]
    },
    {
      "id": "target",
      "type": "text",
      "label": "Who to replace in the video",
      "default": "person",
      "help": "Text description of one subject. The highest-scoring match is detected in each frame; not for multiple similar subjects.",
      "bind": [
        {
          "node": "213:191",
          "field": "text"
        }
      ]
    },
    {
      "id": "mode",
      "type": "select",
      "label": "Mode",
      "default": true,
      "options": [
        {
          "value": true,
          "label": "Replace: your character takes their place in the video"
        }
      ],
      "bind": [
        {
          "node": "213:203",
          "field": "value"
        }
      ],
      "help": "Mode remplacement validé. Le mode animation seule reste hors qualification."
    },
    {
      "id": "width",
      "type": "select",
      "label": "Width",
      "default": 384,
      "options": [
        {
          "value": 384,
          "label": "384 px (preview)"
        }
      ],
      "bind": [
        {
          "node": "213:178",
          "field": "value"
        }
      ]
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": 384,
      "options": [
        {
          "value": 384,
          "label": "384 px (preview)"
        }
      ],
      "bind": [
        {
          "node": "213:179",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "213:19",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "202",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "realrebelai/SCAIL-2_GGUF",
      "file": "SCAIL-2-Q3_K_M.gguf",
      "dir": "unet_gguf",
      "gb": 8.108662432,
      "phase": "denoise",
      "license": "MIT"
    },
    {
      "repo": "Comfy-Org/SCAIL-2",
      "file": "loras/wan2.1_SCAIL_2_DPO_lora_bf16.safetensors",
      "dir": "loras",
      "gb": 1.23,
      "phase": "denoise",
      "license": "MIT"
    },
    {
      "repo": "Kijai/WanVideo_comfy",
      "file": "Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "dir": "loras",
      "gb": 0.74,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "city96/umt5-xxl-encoder-gguf",
      "file": "umt5-xxl-encoder-Q4_K_M.gguf",
      "dir": "clip_gguf",
      "gb": 3.655145312,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
      "file": "split_files/clip_vision/clip_vision_h.safetensors",
      "dir": "clip_vision",
      "gb": 1.26,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Kijai/WanVideo_comfy",
      "file": "Wan2_1_VAE_bf16.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/sam3.1",
      "file": "checkpoints/sam3.1_multiplex_fp16.safetensors",
      "dir": "checkpoints",
      "gb": 1.75,
      "phase": "aux",
      "license": "SAM License"
    }
  ],
  "notes": "Aperçu d’un sujet, 17 images. Le décor et le remplacement ont été vérifiés. Ressemblance du visage, cadrage et mouvement imparfaits ; pas de certification HD ni de suivi long. Utiliser uniquement des images autorisées.",
  "credits": [
    "SCAIL-2 by Zhipu AI / zai-org (MIT)",
    "SAM 3.1 by Meta (SAM License)",
    "Lightx2v distill LoRA",
    "Workflow: ComfyUI official template"
  ],
  "test": {
    "clip": "test/clip.mp4",
    "character": "test/portrait.png",
    "width": 384,
    "height": 384
  }
}
